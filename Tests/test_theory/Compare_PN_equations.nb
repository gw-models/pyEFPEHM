            "a7NSQCEFPE", "+", "a7SOQCEFPE", "+", "a7SSQCEFPE", "+", 
             "a7SSpQCEFPE", "+", "a7SSSQCEFPE"}], ")"}], 
           SuperscriptBox["y", "7"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
            "a8NSQCEFPE", "+", "a8SOQCEFPE", "+", "a8SSQCEFPE", "+", 
             "a8SSpQCEFPE"}], ")"}], 
           SuperscriptBox["y", "8"]}], "+", 
          RowBox[{"a9NSQCEFPE", " ", 
           SuperscriptBox["y", "9"]}]}], ")"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"De2", "=", 
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"ReleaseHold", "[", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["y", "8"]}], "\[Nu]", 
        RowBox[{"(", 
         RowBox[{"b0EFPE", " ", "+", " ", 
          RowBox[{"b2EFPE", " ", 
           SuperscriptBox["y", "2"]}], "+", 
          RowBox[{
