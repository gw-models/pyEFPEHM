Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Define", " ", "the", " ", "Dy"}], ",", " ", 
    RowBox[{"De2", " ", "and", " ", "D\[Delta]\[Lambda]"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Dy", "=", 
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"ReleaseHold", "[", 
       RowBox[{
        SuperscriptBox["y", "9"], "\[Nu]", 
        RowBox[{"(", 
         RowBox[{"a0EFPE", " ", "+", " ", 
          RowBox[{"a2EFPE", " ", 
           SuperscriptBox["y", "2"]}], "+", 
          RowBox[{
           RowBox[{"(", 
