           RowBox[{"(", 
            RowBox[{
            "a6NSEFPE", "+", "a6SOEFPE", "+", "a6SSEFPE", "+", 
             "a6SSpQCEFPE"}], ")"}], 
           SuperscriptBox["y", "6"]}], "+", 
          RowBox[{
           RowBox[{"(", 
