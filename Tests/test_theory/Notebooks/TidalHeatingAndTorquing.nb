Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Study", " ", "the", " ", "poly"}], "-", 
    RowBox[{"log", " ", "formulas", " ", "defined", " ", "after", " ", 
     RowBox[{"Eq", ".", 
      RowBox[{"(", "3.34", ")"}]}], " ", "of", " ", "2212.13095"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"b2Ref", "[", "\[Chi]_", "]"}], "=", 
     RowBox[{"Im", "[", 
      RowBox[{"PolyGamma", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"3", "+", 
         RowBox[{"2", "\[ImaginaryI]", " ", 
          FractionBox["\[Chi]", 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["\[Chi]", "2"]}]]]}]}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"langevin", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"Coth", "[", "x", "]"}], "-", 
      FractionBox["1", "x"]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"b2", "[", "\[Chi]_", "]"}], "=", 
     RowBox[{
      RowBox[{
       FractionBox["Pi", "2"], 
       RowBox[{"langevin", "[", 
        RowBox[{"Pi", " ", 
         FractionBox[
          RowBox[{"2", "\[Chi]"}], 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["\[Chi]", "2"]}]]]}], "]"}]}], "-", 
      RowBox[{"\[Chi]", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["\[Chi]", "2"]}]], 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], "+", 
         FractionBox["2", 
          RowBox[{"1", "+", 
           RowBox[{"3", 
            SuperscriptBox["\[Chi]", "2"]}]}]]}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"b2Ref", "[", "\[Chi]", "]"}], ",", 
       RowBox[{"b2", "[", "\[Chi]", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Chi]", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}]}]], "Input",
