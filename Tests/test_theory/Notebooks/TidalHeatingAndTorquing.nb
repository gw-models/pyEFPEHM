Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Kepler", " ", "orbit", " ", "in", " ", "Cartesian", " ", "coordinates"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"keprules", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xx", "->", 
        RowBox[{"aa", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cos", "[", "u", "]"}], "-", "e"}], ")"}]}]}], ",", " ", 
       RowBox[{"yy", "->", 
        RowBox[{"aa", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["e", "2"]}]], 
         RowBox[{"Sin", "[", "u", "]"}]}]}], ",", 
       RowBox[{"xxdot", "->", 
        RowBox[{"nn", " ", "aa", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"-", 
            RowBox[{"Sin", "[", "u", "]"}]}], ")"}], 
          RowBox[{"1", "-", 
           RowBox[{"e", " ", 
            RowBox[{"Cos", "[", "u", "]"}]}]}]]}]}], ",", 
       RowBox[{"yydot", "->", 
        RowBox[{"nn", " ", "aa", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["e", "2"]}]], " ", 
            RowBox[{"Cos", "[", "u", "]"}]}], ")"}], 
          RowBox[{"1", "-", 
           RowBox[{"e", " ", 
            RowBox[{"Cos", "[", "u", "]"}]}]}]]}]}], ",", 
       RowBox[{
        StyleBox["r",
         ShowAutoStyles->False,
         AutoSpacing->False], "->", 
        RowBox[{"aa", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"e", " ", 
            RowBox[{"Cos", "[", "u", "]"}]}]}], ")"}]}]}], ",", 
       RowBox[{"v", "->", 
        RowBox[{"nn", " ", "aa", " ", 
         SqrtBox[
          FractionBox[
           RowBox[{"1", "+", 
            RowBox[{"e", " ", 
             RowBox[{
              InterpretationBox[
               StyleBox["Cos",
                ShowAutoStyles->False,
                AutoSpacing->False],
               Cos,
               Editable->False], "[", "u", "]"}]}]}], 
           RowBox[{"1", "-", 
            RowBox[{"e", " ", 
             RowBox[{
              InterpretationBox[
               StyleBox["Cos",
                ShowAutoStyles->False,
                AutoSpacing->False],
               Cos,
               Editable->False], "[", "u", "]"}]}]}]]]}]}], ",", 
       RowBox[{"vn", "->", 
        RowBox[{"nn", " ", "aa", 
         FractionBox[
          RowBox[{" ", 
           RowBox[{"e", " ", 
            RowBox[{
             InterpretationBox[
              StyleBox["Sin",
               ShowAutoStyles->False,
               AutoSpacing->False],
              Sin,
              Editable->False], "[", "u", "]"}]}]}], 
          RowBox[{"1", "-", 
           RowBox[{"e", " ", 
            RowBox[{
             InterpretationBox[
              StyleBox["Cos",
               ShowAutoStyles->False,
               AutoSpacing->False],
              Cos,
              Editable->False], "[", "u", "]"}]}]}]]}]}], ",", 
       RowBox[{"s1l", "->", 
        RowBox[{
         SuperscriptBox["aa", "2"], " ", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["e", "2"]}]], " ", "nn", " ", "s1z"}]}], ",", 
       RowBox[{"s1n", "->", 
        FractionBox[
         RowBox[{
          RowBox[{"s1x", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Cos", "[", "u", "]"}], "-", "e"}], ")"}]}], "+", 
          RowBox[{"s1y", " ", 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["e", "2"]}]], 
           RowBox[{"Sin", "[", "u", "]"}]}]}], 
         RowBox[{"1", "-", 
          RowBox[{"e", " ", 
           RowBox[{"Cos", "[", "u", "]"}]}]}]]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Simplification", " ", "rules"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simpspins", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s1x", "->", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]1", "]"}], 
         RowBox[{"Cos", "[", "\[Psi]1", "]"}]}]}], ",", 
       RowBox[{"s1y", "->", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]1", "]"}], 
         RowBox[{"Sin", "[", "\[Psi]1", "]"}]}]}], ",", 
       RowBox[{"s1z", "->", 
        RowBox[{"Cos", "[", "\[Theta]1", "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simpEFPE", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aa", "->", 
        FractionBox["m", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox["e", "2"]}], ")"}], 
          SuperscriptBox["y", "2"]}]]}], ",", 
       RowBox[{"nn", "->", 
        FractionBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["e", "2"]}], ")"}], 
           RowBox[{"3", "/", "2"}]], 
          SuperscriptBox["y", "3"]}], "m"]}], ",", 
       RowBox[{"m1", "->", 
        RowBox[{"\[Mu]1", " ", "m"}]}], ",", " ", 
       RowBox[{"m2", "->", 
        RowBox[{"\[Mu]2", " ", "m"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Check", " ", "different", " ", "parts", " ", "of", " ", "our", " ", 
     "kepler", " ", "rules"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"nn", " ", 
       FractionBox[
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"xx", "/.", "keprules"}], ",", "u"}], "]"}], 
        RowBox[{"1", "-", 
         RowBox[{"e", " ", 
          RowBox[{"Cos", "[", "u", "]"}]}]}]]}], "-", "xxdot"}], "/.", 
     "keprules"}], " ", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"nn", " ", 
       FractionBox[
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"yy", "/.", "keprules"}], ",", "u"}], "]"}], 
        RowBox[{"1", "-", 
         RowBox[{"e", " ", 
          RowBox[{"Cos", "[", "u", "]"}]}]}]]}], "-", "yydot"}], "/.", 
     "keprules"}], " ", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox["xx", "2"], "+", 
         SuperscriptBox["yy", "2"]}]], " ", "-", "r"}], ")"}], "/.", 
     "keprules"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox["xxdot", "2"], "+", 
         SuperscriptBox["yydot", "2"]}]], " ", "-", "v"}], ")"}], "/.", 
     "keprules"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"{", 
          RowBox[{"xx", ",", "yy", ",", "0"}], "}"}], ".", 
         RowBox[{"{", 
          RowBox[{"xxdot", ",", "yydot", ",", "0"}], "}"}]}], "r"], "-", 
       "vn"}], ")"}], "/.", "keprules"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Check", " ", "the", " ", "value", " ", "of", " ", "angular", " ", 
      "momentum", " ", "vector", " ", 
      RowBox[{"l", "[", "a", "]"}]}], "=", 
     RowBox[{
      RowBox[{"epsilonmetric", "[", 
       RowBox[{"a", ",", 
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "c"}]}], "]"}], " ", 
      RowBox[{"x", "[", "b", "]"}], " ", 
      RowBox[{"xdot", "[", "c", "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lKepNorm", "=", 
     FractionBox["m", "y"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lKep", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "lKepNorm"}], "}"}]}], ";"}], 
