       SuperscriptBox["\[Delta]\[Chi]diff", "3"]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "of", " ", 
     RowBox[{"Eq", ".", 
      RowBox[{"(", "77", ")"}]}], " ", "for", " ", 
     SuperscriptBox["\[Delta]\[Chi]", "n"]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Delta]\[Chi]int", "[", 
      RowBox[{"m_", ",", "\[Phi]_"}], "]"}], "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"\[Delta]\[Chi]", "[", "\[Phi]", "]"}], 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"m", " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}]}]]], ",", "\[Phi]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Delta]\[Chi]2int", "[", 
      RowBox[{"m_", ",", "\[Phi]_"}], "]"}], "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"\[Delta]\[Chi]", "[", "\[Phi]", "]"}], "2"], 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"m", " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}]}]]], ",", "\[Phi]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Delta]\[Chi]3int", "[", 
      RowBox[{"m_", ",", "\[Phi]_"}], "]"}], "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"\[Delta]\[Chi]", "[", "\[Phi]", "]"}], "3"], 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"m", " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}]}]]], ",", "\[Phi]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Compare", " ", "with"}], " ", "<", 
     SuperscriptBox["\[Delta]\[Chi]", "n"], ">", " ", 
     RowBox[{"computed", " ", "from", " ", 
      RowBox[{"Eq", ".", 
       RowBox[{"(", "77", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"\[Delta]\[Chi]precavg", "[", "m", "]"}], "-", 
     FractionBox[
      RowBox[{
       RowBox[{"\[Delta]\[Chi]int", "[", 
        RowBox[{"m", ",", 
         FractionBox["Pi", "2"]}], "]"}], "-", 
       RowBox[{"\[Delta]\[Chi]int", "[", 
        RowBox[{"m", ",", 
         RowBox[{"-", 
          FractionBox["Pi", "2"]}]}], "]"}]}], 
      RowBox[{"2", 
       RowBox[{"EllipticK", "[", "m", "]"}]}]]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"\[Delta]\[Chi]2precavg", "[", "m", "]"}], "-", 
     FractionBox[
      RowBox[{
       RowBox[{"\[Delta]\[Chi]2int", "[", 
        RowBox[{"m", ",", 
         FractionBox["Pi", "2"]}], "]"}], "-", 
       RowBox[{"\[Delta]\[Chi]2int", "[", 
        RowBox[{"m", ",", 
         RowBox[{"-", 
          FractionBox["Pi", "2"]}]}], "]"}]}], 
      RowBox[{"2", 
       RowBox[{"EllipticK", "[", "m", "]"}]}]]}], "]"}], 
   "\[IndentingNewLine]", 
